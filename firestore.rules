rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Zones and venues: public read, no client writes (seeded via script / console)
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if false;
    }

    match /venues/{venueId} {
      allow read: if true;
      allow write: if false;
    }

    // Guest orders: anyone can create, nobody can read or update from the client
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Everything else: denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
